APP_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=memory:
DATABASE_SSL=false
LOG_LEVEL=info
ENABLE_API_DOCS=true
SCORING_RELEASE_ID=stage-c-trusted-likelihood-v2
REPOSITORY_URL=https://github.com/OWNER/REPO
# Set only when the API is behind a known proxy. Accepts IP/CIDR values or a hop count.
TRUST_PROXY=
# Absolute Vite build path when the API also serves the production frontend.
FRONTEND_DIST_DIR=

# Required outside development. Generate independent values for each setting.
TOKEN_PEPPER=replace-with-at-least-32-random-characters
QUOTE_SIGNING_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64-value
